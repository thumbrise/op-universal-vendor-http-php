{
    "name": "thumbrise/op-universal-vendor-http",
    "description": "OP vendor - Universal HTTP - PHP type definitions",
    "license": "Apache-2.0",
    "type": "library",
    "autoload": {
        "psr-4": {
            "Thumbrise\\OP\\Universal\\Vendors\\Http\\": "./src"
        }
    },
    "require": {
        "php": ">=8.1",
        "thumbrise/op-universal-schema": "*"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3"
    },
    "scripts": {
        "lint": [
            "@php vendor/bin/php-cs-fixer fix"
        ],
        "lint:ci": [
            "@php vendor/bin/php-cs-fixer check"
        ]
    }
}
